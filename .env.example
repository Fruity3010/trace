# ── Required in production ─────────────────────────────────────────────
# Password for the staff dashboard (/intel) and dispute decisions. Any username.
ADMIN_PASSWORD=

# Partner API keys for POST /v1/check-account, comma-separated.
# If unset, the partner API is open in development and closed in production.
TRACE_API_KEYS=

# Twilio auth token. Verifies X-Twilio-Signature on /api/whatsapp.
# If unset, unsigned requests are accepted in development only.
TWILIO_AUTH_TOKEN=

# Show WhatsApp's "typing…" bubble while TRACE thinks. Needs both Twilio
# credentials. Cosmetic — a failure never affects the reply.
TWILIO_TYPING_INDICATOR=false

# ── Optional ───────────────────────────────────────────────────────────
# Gemini for report classification and pattern write-ups. Without it TRACE
# uses a deterministic offline classifier. Server-only.
GEMINI_API_KEY=
# Model name; override if Google retires the default.
GEMINI_MODEL=gemini-flash-lite-latest

# Paystack secret key. Enables account-name lookup (Resolve Account Number).
# Names are shown only to the person checking and never stored.
PAYSTACK_SECRET_KEY=

# Twilio account SID. Needed to download screenshots sent to the WhatsApp bot
# when media URLs require authentication.
TWILIO_ACCOUNT_SID=

# Your Twilio WhatsApp number, e.g. +14155238886. Shows "Check on WhatsApp" links.
NEXT_PUBLIC_TRACE_WHATSAPP_NUMBER=
# First message pre-filled in those links (default "Hi"). On the Twilio sandbox, use your
# "join <code>" phrase: the bot cannot reply to anyone who has not joined.
NEXT_PUBLIC_TRACE_WHATSAPP_TEXT=

# Secret used to hash reporter device IDs and phone numbers. Generated and
# stored in the database on first run if unset. Set it to keep hashes stable
# across database moves.
TRACE_SECRET=

# Where trace.db and evidence uploads live (default ./data).
TRACE_DATA_DIR=

# Set to false to start with an empty database instead of sample reports.
TRACE_SEED_SAMPLE=
